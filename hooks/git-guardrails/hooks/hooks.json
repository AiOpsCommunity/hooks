{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/git-guardrails.py",
            "if": "Bash(git *)",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
